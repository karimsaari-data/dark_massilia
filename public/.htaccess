<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Redirections 301 — nouvelles URLs SEO ───────────────────────────────
  RewriteRule ^missions/?$    /depollution-marine              [R=301,L]
  RewriteRule ^photos/?$      /photographie-paysage-mer        [R=301,L]
  RewriteRule ^sources/?$     /donnees-scientifiques           [R=301,L]
  RewriteRule ^medias/?$      /presse                          [R=301,L]
  RewriteRule ^reseaux/?$     /communaute                      [R=301,L]
  RewriteRule ^local-guide/?$ /local-guide-marseille           [R=301,L]
  RewriteRule ^carte/?$       /carte-calanques                 [R=301,L]
  RewriteRule ^arte/?$        /sauver-marseille-documentaire-arte [R=301,L]
  RewriteRule ^twitter/?$     /actualites                      [R=301,L]

  # ── Redirections 301 — legacy URLs (ex-site statique .html) ─────────────
  RewriteRule ^home/?$       /  [R=301,L]
  RewriteRule ^index\.html$  /  [R=301,L]
  RewriteRule ^photos\.html$ /photographie-paysage-mer        [R=301,L]
  RewriteRule ^videos\.html$ /videos                          [R=301,L]
  RewriteRule ^medias\.html$ /presse                          [R=301,L]
  RewriteRule ^arte\.html$   /sauver-marseille-documentaire-arte [R=301,L]

  # ── Redirections 301 — legacy URLs avec préfixe /home/ (ex-site statique) ──
  RewriteRule ^home/photos/?$   /photographie-paysage-mer           [R=301,L]
  RewriteRule ^home/videos/?$   /videos                             [R=301,L]
  RewriteRule ^home/medias/?$   /presse                             [R=301,L]
  RewriteRule ^home/arte/?$     /sauver-marseille-documentaire-arte [R=301,L]
  RewriteRule ^home/carte/?$    /carte-calanques                    [R=301,L]
  RewriteRule ^home/twitter/?$  /actualites                         [R=301,L]

  # ── Prérendu statique — servir {route}/index.html si disponible ────────
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # ── SPA fallback — toutes les autres routes vers index.html ─────────────
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ── Compression GZIP dynamique ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Cache navigateur ────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Security headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header append Vary Accept-Encoding
</IfModule>
