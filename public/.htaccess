<IfModule mod_dir.c>
  # Désactive la redirection automatique /page → /page/ d'Apache
  # Sans cela, les dossiers prérendus génèrent un trailing-slash non voulu
  # qui crée un mismatch avec les canonicals et les liens internes (0 inlink Ahrefs)
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Canonicalisation — forcer non-www (évite la duplication www/non-www) ──
  RewriteCond %{HTTP_HOST} ^www\.karimsaari\.com$ [NC]
  RewriteRule ^(.*)$ https://karimsaari.com/$1 [R=301,L]

  # ── Canonicalisation — supprimer le slash final (sauf racine) ────────────
  # Redirige /page/ → /page en 301 pour aligner les URLs crawlées par Ahrefs/Google
  # avec les canonicals déclarés (sans slash) et les liens internes React Router
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # ── Redirections 301 — nouvelles URLs SEO ───────────────────────────────
  RewriteRule ^missions/?$    /depollution-marine              [R=301,L]
  RewriteRule ^photos/?$      /photographie-paysage-mer        [R=301,L]
  RewriteRule ^sources/?$     /donnees-scientifiques           [R=301,L]
  RewriteRule ^medias/?$      /presse                          [R=301,L]
  RewriteRule ^reseaux/?$     /communaute                      [R=301,L]
  RewriteRule ^local-guide/?$ /local-guide-marseille           [R=301,L]
  RewriteRule ^carte/?$       /carte-calanques                 [R=301,L]
  RewriteRule ^arte/?$        /sauver-marseille-documentaire-arte [R=301,L]
  RewriteRule ^twitter/?$     /actualites                      [R=301,L]

  # ── Redirections 301 — legacy URLs (ex-site statique .html) ─────────────
  RewriteRule ^home/?$       /  [R=301,L]
  RewriteRule ^index$        /  [R=301,L]
  RewriteRule ^index\.html$  /  [R=301,L]
  RewriteRule ^photos\.html$ /photographie-paysage-mer        [R=301,L]
  RewriteRule ^videos\.html$ /videos                          [R=301,L]
  RewriteRule ^medias\.html$ /presse                          [R=301,L]
  RewriteRule ^arte\.html$   /sauver-marseille-documentaire-arte [R=301,L]

  # ── Redirections 301 — anciennes URLs photo/carte ───────────────────────
  RewriteRule ^carte-photos/?$ /photographie-paysage-mer      [R=301,L]

  # ── Redirections 301 — articles blog renommés/supprimés ─────────────────
  RewriteRule ^blog/oxygene-le-documentaire-sur-la-depollution-de-la-mediterranee/?$ /blog [R=301,L]

  # ── Redirections 301 — slugs WordPress avec emoji (anciens slugs indexés par Google) ──
  RewriteRule ^blog/%F0%9F%8C%8A-proteger-notre-grande-bleue-4-gestes-simples-pour-sauver-la-mediterranee/?$ /blog/proteger-notre-grande-bleue-4-gestes-simples-pour-sauver-la-mediterranee [R=301,L]

  # ── Redirections 301 — legacy URLs avec préfixe /home/ (ex-site statique) ──
  RewriteRule ^home/photos/?$   /photographie-paysage-mer           [R=301,L]
  RewriteRule ^home/videos/?$   /videos                             [R=301,L]
  RewriteRule ^home/medias/?$   /presse                             [R=301,L]
  RewriteRule ^home/arte/?$     /sauver-marseille-documentaire-arte [R=301,L]
  RewriteRule ^home/carte/?$    /carte-calanques                    [R=301,L]
  RewriteRule ^home/twitter/?$  /actualites                         [R=301,L]

  # ── Prérendu statique — servir {route}/index.html si disponible ────────
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # ── SPA fallback — toutes les autres routes vers index.html ─────────────
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ── Types MIME spéciaux ─────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType text/vcard .vcf
</IfModule>
<IfModule mod_headers.c>
  <Files "*.vcf">
    Header set Content-Disposition "attachment"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# ── Compression GZIP dynamique ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Cache navigateur ────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Cache-Control explicite (complète mod_expires pour PageSpeed) ───────────
<IfModule mod_headers.c>
  # Images — 1 an (noms sémantiques stables, immutable pour les assets hashés Vite)
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # JS/CSS buildés par Vite — noms hashés → immutable
  # FilesMatch teste le basename uniquement (sans chemin), donc on détecte
  # le hash Vite par sa structure : nom-XXXXXXXX.js / .css  (8 chars alphanumériques)
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML — toujours revalidé (SPA + pages prérendues)
  # "always" garantit l'override même après un RewriteRule interne
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Security headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header append Vary Accept-Encoding
  # HSTS — force HTTPS pendant 1 an
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Isolation cross-origin (COOP)
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Content Security Policy — autorise Google Fonts, GTM/GA, Supabase, YouTube/Vimeo
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src https://www.youtube.com https://player.vimeo.com https://www.instagram.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self';"
</IfModule>
