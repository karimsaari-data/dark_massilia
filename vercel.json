{
  "trailingSlash": false,
  "redirects": [
    { "source": "/home",         "destination": "/", "permanent": true },
    { "source": "/home/",        "destination": "/", "permanent": true },
    { "source": "/index.html",   "destination": "/", "permanent": true },
    { "source": "/index",        "destination": "/", "permanent": true },

    { "source": "/missions",     "destination": "/depollution-marine", "permanent": true },

    { "source": "/medias",       "destination": "/presse",             "permanent": true },
    { "source": "/medias.html",  "destination": "/presse",             "permanent": true },

    { "source": "/photos",       "destination": "/photographie-paysage-mer", "permanent": true },
    { "source": "/photos.html",  "destination": "/photographie-paysage-mer", "permanent": true },

    { "source": "/arte",         "destination": "/sauver-marseille-documentaire-arte", "permanent": true },
    { "source": "/arte.html",    "destination": "/sauver-marseille-documentaire-arte", "permanent": true },

    { "source": "/sources",      "destination": "/donnees-scientifiques", "permanent": true },

    { "source": "/local-guide",  "destination": "/local-guide-marseille", "permanent": true },

    { "source": "/reseaux",      "destination": "/communaute",         "permanent": true },

    { "source": "/twitter",      "destination": "/actualites",         "permanent": true },
    { "source": "/actu-x",       "destination": "/actualites",         "permanent": true },
    { "source": "/actu-x.html",  "destination": "/actualites",         "permanent": true },

    { "source": "/carte",        "destination": "/carte-calanques",    "permanent": true },

    { "source": "/admin-galerie","destination": "/admin",              "permanent": true },

    { "source": "/videos.html",  "destination": "/videos",             "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
