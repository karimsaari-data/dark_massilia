{
  "ci": {
    "collect": {
      "url": [
        "https://karimsaari.com/home",
        "https://karimsaari.com/photographie-sous-marine",
        "https://karimsaari.com/donnees-scientifiques",
        "https://karimsaari.com/blog",
        "https://karimsaari.com/depollution-marine",
        "https://karimsaari.com/carte-calanques"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo":            ["error", { "minScore": 0.90 }],
        "categories:performance":    ["error", { "minScore": 0.60 }],
        "categories:accessibility":  ["warn",  { "minScore": 0.80 }],
        "categories:best-practices": ["warn",  { "minScore": 0.80 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
